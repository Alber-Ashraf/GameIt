# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY GameIt.sln ./
COPY src/Core/GameIt.Domain/GameIt.Domain.csproj src/Core/GameIt.Domain/
COPY src/Core/GameIt.Contracts/GameIt.Contracts.csproj src/Core/GameIt.Contracts/
COPY src/Core/GameIt.Application/GameIt.Application.csproj src/Core/GameIt.Application/
COPY src/Infrastructure/GameIt.Persistence/GameIt.Persistence.csproj src/Infrastructure/GameIt.Persistence/
COPY src/Infrastructure/GameIt.Identity/GameIt.Identity.csproj src/Infrastructure/GameIt.Identity/
COPY src/Infrastructure/GameIt.Infrastructure/GameIt.Infrastructure.csproj src/Infrastructure/GameIt.Infrastructure/
COPY src/Presentation/GameIt.API/GameIt.API.csproj src/Presentation/GameIt.API/

RUN dotnet restore src/Presentation/GameIt.API/GameIt.API.csproj

COPY src/ src/
RUN dotnet publish src/Presentation/GameIt.API/GameIt.API.csproj -c Release -o /app/publish /p:UseAppHost=false

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
USER app
EXPOSE 8080

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "GameIt.API.dll"]

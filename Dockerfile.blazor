# Stage 1: Build Blazor WebAssembly
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY src/Core/GameIt.Contracts/GameIt.Contracts.csproj src/Core/GameIt.Contracts/
COPY src/Presentation/GameIt.BlazorUI/GameIt.BlazorUI.csproj src/Presentation/GameIt.BlazorUI/

RUN dotnet restore src/Presentation/GameIt.BlazorUI/GameIt.BlazorUI.csproj

COPY src/Core/GameIt.Contracts/ src/Core/GameIt.Contracts/
COPY src/Presentation/GameIt.BlazorUI/ src/Presentation/GameIt.BlazorUI/

RUN dotnet publish src/Presentation/GameIt.BlazorUI/GameIt.BlazorUI.csproj -c Release -o /app/publish

# Stage 2: Serve static assets via Nginx
FROM nginx:1.27-alpine AS final
WORKDIR /usr/share/nginx/html

COPY --from=build /app/publish/wwwroot .
COPY src/Presentation/GameIt.BlazorUI/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

@page "/purchases"
@attribute [Authorize]
@using GameIt.BlazorUI.Features.Purchases.Services
@inject IPurchasesApiClient PurchasesApi
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>Purchase History — GameIt</PageTitle>

<PageHeader Eyebrow="Billing & Receipts"
            Title="Purchase History"
            Subtitle="Review your digital orders, payment statuses, and transaction receipts." />

<ErrorBanner Message="@_errorMessage" OnRetry="LoadHistoryAsync" />

@if (_isLoading)
{
    <div class="gi-card" style="padding:var(--space-5);">
        <div class="gi-skeleton" style="height:2.2rem;width:100%;margin-bottom:var(--space-3);"></div>
        <div class="gi-skeleton" style="height:2.2rem;width:100%;margin-bottom:var(--space-3);"></div>
        <div class="gi-skeleton" style="height:2.2rem;width:100%;"></div>
    </div>
}
else if (_purchases.Count == 0)
{
    <EmptyState Icon="bi-receipt"
                Title="No transactions recorded yet"
                Description="When you purchase or claim games from the storefront, your receipts will appear here.">
        <Action>
            <a href="/" class="gi-btn gi-btn-primary">Browse Storefront</a>
        </Action>
    </EmptyState>
}
else
{
    <div class="gi-table-wrap">
        <table class="gi-table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th style="text-align:right;">Amount Paid</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _purchases.OrderByDescending(p => p.PurchaseDate))
                {
                    <tr>
                        <td class="tabular-nums" style="color:var(--text-muted);font-size:0.8rem;">
                            #@item.Id.ToString("N")[..8].ToUpperInvariant()
                        </td>
                        <td>
                            <a href="@($"/games/{item.GameId}")" style="font-weight:600;color:var(--text-primary);">
                                @(string.IsNullOrWhiteSpace(item.GameName) ? "Digital Game Edition" : item.GameName)
                            </a>
                        </td>
                        <td class="tabular-nums" style="color:var(--text-secondary);">
                            @item.PurchaseDate.ToString("MMM dd, yyyy HH:mm")
                        </td>
                        <td>
                            <div style="display:flex;align-items:center;gap:var(--space-2);">
                                <span class="gi-badge @(GetStatusBadgeClass(item.Status))">
                                    @item.Status
                                </span>
                                @if (item.Status == PaymentStatusContract.Pending)
                                {
                                    <button type="button"
                                            class="gi-btn gi-btn-secondary gi-btn-sm"
                                            style="padding:2px 8px;font-size:0.75rem;"
                                            disabled="@_isVerifying"
                                            @onclick="() => VerifyPurchaseAsync(item.Id)">
                                        <i class="bi bi-arrow-clockwise"></i> Check Status
                                    </button>
                                }
                            </div>
                        </td>
                        <td class="tabular-nums" style="text-align:right;font-weight:700;">
                            @(item.AmountPaid == 0m ? "FREE ($0.00)" : $"${item.AmountPaid:0.00}")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<PurchaseItemDto> _purchases = new();
    private bool _isLoading = true;
    private bool _isVerifying;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task VerifyPurchaseAsync(Guid purchaseId)
    {
        _isVerifying = true;
        try
        {
            var res = await PurchasesApi.VerifyPurchaseAsync(purchaseId);
            if (res.IsSuccess && res.Data?.IsSuccess == true)
            {
                Toast.ShowSuccess($"Payment confirmed! {res.Data.GameName} has been added to your library.", "Order Updated");
                await LoadHistoryAsync();
            }
            else
            {
                Toast.ShowInfo(res.Data?.Message ?? res.ErrorMessage ?? "Payment is still pending on Stripe.", "Status Check");
            }
        }
        catch
        {
            Toast.ShowError("Unable to verify payment with Stripe at this moment.", "Verification Failed");
        }
        finally
        {
            _isVerifying = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var res = await PurchasesApi.GetUserPurchasesAsync();
            if (res.IsSuccess && res.Data is not null)
            {
                _purchases = res.Data;
            }
            else
            {
                _errorMessage = res.ErrorMessage ?? "Failed to load purchase history.";
            }
        }
        catch
        {
            _errorMessage = "Unable to connect to the billing service.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetStatusBadgeClass(PaymentStatusContract status) => status switch
    {
        PaymentStatusContract.Succeeded => "gi-badge-free",
        PaymentStatusContract.Pending => "gi-badge-indigo",
        _ => "gi-badge-category"
    };
}

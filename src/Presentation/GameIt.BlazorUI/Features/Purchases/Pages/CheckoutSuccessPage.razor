@page "/checkout/success"
@attribute [Authorize]

<PageTitle>Order Confirmed — GameIt</PageTitle>

<div style="max-width:540px;margin:var(--space-8) auto;">
    <div class="gi-card" style="padding:var(--space-8);text-align:center;">
        <div style="width:64px;height:64px;margin:0 auto var(--space-4);border-radius:var(--radius-full);background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.3);display:flex;align-items:center;justify-content:center;color:var(--emerald-400);font-size:2rem;">
            <i class="bi bi-check2-circle"></i>
        </div>

        <h1 style="font-size:1.6rem;margin-bottom:var(--space-2);">Payment Successful!</h1>
        <p style="color:var(--text-secondary);font-size:0.92rem;line-height:1.6;margin-bottom:var(--space-6);">
            Your order has been verified and processed. Your new digital edition is ready in your library for immediate installation.
        </p>

        <div style="display:flex;flex-direction:column;gap:var(--space-3);">
            <a href="/library" class="gi-btn gi-btn-primary gi-btn-lg" style="width:100%;">
                <i class="bi bi-collection-play-fill"></i> View In My Library
            </a>
            <a href="/purchases" class="gi-btn gi-btn-secondary" style="width:100%;">
                <i class="bi bi-receipt"></i> View Order Receipts
            </a>
            <a href="/" class="gi-btn gi-btn-ghost gi-btn-sm" style="width:100%;margin-top:var(--space-2);">
                Continue Shopping
            </a>
        </div>
    </div>
</div>

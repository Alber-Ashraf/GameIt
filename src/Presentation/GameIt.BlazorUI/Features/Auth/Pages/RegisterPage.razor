@page "/register"
@layout AuthLayout
@using GameIt.BlazorUI.Features.Auth.Services
@inject IAuthApiClient AuthApi
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>Create Account — GameIt</PageTitle>

<div style="margin-bottom:var(--space-5);">
    <h1 style="font-size:1.45rem;">Create your GameIt account</h1>
    <p style="font-size:0.86rem;color:var(--text-secondary);margin-top:0.25rem;">
        Build your PC game collection, track deals, and review titles.
    </p>
</div>

<ErrorBanner Message="@_errorMessage" />

<EditForm Model="_model" OnValidSubmit="HandleRegisterAsync">
    <DataAnnotationsValidator />

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3);">
        <div class="gi-form-group">
            <label class="gi-label" for="reg-first">First Name</label>
            <InputText id="reg-first" class="gi-input" placeholder="Alex" @bind-Value="_model.FirstName" />
            <ValidationMessage For="@(() => _model.FirstName)" />
        </div>

        <div class="gi-form-group">
            <label class="gi-label" for="reg-last">Last Name</label>
            <InputText id="reg-last" class="gi-input" placeholder="Mercer" @bind-Value="_model.LastName" />
            <ValidationMessage For="@(() => _model.LastName)" />
        </div>
    </div>

    <div class="gi-form-group">
        <label class="gi-label" for="reg-username">Gamer Tag / Username</label>
        <InputText id="reg-username" class="gi-input" placeholder="alexmercer" @bind-Value="_model.UserName" />
        <ValidationMessage For="@(() => _model.UserName)" />
    </div>

    <div class="gi-form-group">
        <label class="gi-label" for="reg-email">Email Address</label>
        <InputText id="reg-email" type="email" class="gi-input" placeholder="alex@gameit.com" @bind-Value="_model.Email" />
        <ValidationMessage For="@(() => _model.Email)" />
    </div>

    <div class="gi-form-group">
        <label class="gi-label" for="reg-password">Password</label>
        <InputText id="reg-password" type="password" class="gi-input" placeholder="At least 6 characters" @bind-Value="_model.Password" />
        <ValidationMessage For="@(() => _model.Password)" />
    </div>

    <button type="submit" class="gi-btn gi-btn-primary gi-btn-lg" style="width:100%;margin-top:var(--space-2);" disabled="@_isSubmitting">
        @if (_isSubmitting)
        {
            <span>Creating Account...</span>
        }
        else
        {
            <i class="bi bi-person-plus"></i>
            <span>Create Account</span>
        }
    </button>
</EditForm>

<div style="margin-top:var(--space-5);text-align:center;font-size:0.85rem;color:var(--text-secondary);">
    Already have an account?
    <a href="/login" style="color:var(--accent-text);font-weight:600;margin-left:4px;">Sign in</a>
</div>

@code {
    private readonly RegistrationRequestDto _model = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task HandleRegisterAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var result = await AuthApi.RegisterAsync(_model);
            if (result.IsSuccess)
            {
                Toast.ShowSuccess("Your account has been created. Please sign in.", "Registration Complete");
                Navigation.NavigateTo("/login");
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Registration failed. Please verify your details.";
            }
        }
        catch
        {
            _errorMessage = "Unable to reach the authentication server. Please verify the API is running.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}

@inherits LayoutComponentBase

<div class="gi-auth-shell">
    <div class="gi-auth-card">
        <div style="display:flex;flex-direction:column;align-items:center;margin-bottom:var(--space-6);text-align:center;">
            <a href="/" style="display:flex;align-items:center;gap:var(--space-2);text-decoration:none;margin-bottom:var(--space-3);">
                <div class="gi-brand-mark">
                    <i class="bi bi-controller"></i>
                </div>
                <span style="font-weight:800;font-size:1.35rem;letter-spacing:-0.03em;">GameIt</span>
            </a>
            <div style="font-size:0.85rem;color:var(--text-secondary);">Enterprise PC Gaming Storefront</div>
        </div>

        @Body
    </div>
</div>

<ToastContainer />

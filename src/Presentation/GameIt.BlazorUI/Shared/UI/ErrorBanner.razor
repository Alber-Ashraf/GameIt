@if (!string.IsNullOrWhiteSpace(Message))
{
    <div style="background-color:var(--status-danger-bg);border:1px solid rgba(239,68,68,0.35);border-radius:var(--radius-md);padding:var(--space-3) var(--space-4);display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);margin-bottom:var(--space-4);" role="alert">
        <div style="display:flex;align-items:center;gap:var(--space-3);color:var(--rose-400);font-size:0.88rem;">
            <i class="bi bi-exclamation-triangle-fill" style="font-size:1.05rem;"></i>
            <span>@Message</span>
        </div>
        @if (OnRetry.HasDelegate)
        {
            <button type="button" class="gi-btn gi-btn-sm gi-btn-danger" @onclick="OnRetry">
                <i class="bi bi-arrow-clockwise"></i> Retry
            </button>
        }
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}

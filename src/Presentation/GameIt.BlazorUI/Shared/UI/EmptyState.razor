<div class="gi-state-box" role="status">
    <div class="gi-state-icon">
        <i class="bi @Icon"></i>
    </div>
    <h3 style="font-size:1.1rem;">@Title</h3>
    <p style="color:var(--text-secondary);font-size:0.88rem;max-width:400px;">@Description</p>
    @if (Action is not null)
    {
        <div style="margin-top:var(--space-2);">
            @Action
        </div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "bi-inbox";
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Action { get; set; }
}

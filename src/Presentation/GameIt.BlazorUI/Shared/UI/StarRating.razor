<div style="display:inline-flex;align-items:center;gap:0.25rem;" title="@($"{Rating:0.0} / 5.0")">
    @for (int i = 1; i <= 5; i++)
    {
        var starIndex = i;
        var filled = Rating >= starIndex - 0.25;
        var half = !filled && Rating >= starIndex - 0.75;
        if (Interactive)
        {
            <button type="button"
                    class="gi-btn-ghost"
                    style="padding:2px;border:none;background:transparent;cursor:pointer;color:@(filled ? "var(--amber-400)" : "var(--zinc-600)");font-size:1.1rem;"
                    @onclick="() => OnStarClicked(starIndex)"
                    aria-label="@($"Rate {starIndex} stars")">
                <i class="bi @(filled ? "bi-star-fill" : "bi-star")"></i>
            </button>
        }
        else
        {
            <i class="bi @(filled ? "bi-star-fill" : (half ? "bi-star-half" : "bi-star"))"
               style="color:@(filled || half ? "var(--amber-400)" : "var(--zinc-600)");font-size:0.82rem;"></i>
        }
    }
    @if (ShowValue)
    {
        <span class="tabular-nums" style="font-size:0.8rem;color:var(--text-secondary);margin-left:0.2rem;">
            @(Rating > 0 ? Rating.Value.ToString("0.0") : "New")
        </span>
    }
</div>

@code {
    [Parameter] public double? Rating { get; set; }
    [Parameter] public bool ShowValue { get; set; } = true;
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public EventCallback<int> RatingChanged { get; set; }

    private async Task OnStarClicked(int value)
    {
        Rating = value;
        if (RatingChanged.HasDelegate)
        {
            await RatingChanged.InvokeAsync(value);
        }
    }
}

@using GameIt.BlazorUI.Core.Notifications
@inject ToastService ToastService
@implements IDisposable

<div class="gi-toast-stack" aria-live="polite">
    @foreach (var toast in ToastService.Toasts)
    {
        var levelClass = toast.Level switch
        {
            ToastLevel.Success => "gi-toast-success",
            ToastLevel.Info => "gi-toast-info",
            ToastLevel.Warning => "gi-toast-warning",
            ToastLevel.Error => "gi-toast-error",
            _ => "gi-toast-info"
        };
        var iconClass = toast.Level switch
        {
            ToastLevel.Success => "bi-check-circle-fill",
            ToastLevel.Info => "bi-info-circle-fill",
            ToastLevel.Warning => "bi-exclamation-triangle-fill",
            ToastLevel.Error => "bi-x-circle-fill",
            _ => "bi-info-circle-fill"
        };

        <div class="gi-toast @levelClass" role="alert">
            <div style="display:flex;align-items:flex-start;gap:var(--space-3);">
                <i class="bi @iconClass" style="margin-top:2px;"></i>
                <div>
                    <div style="font-weight:700;font-size:0.85rem;color:var(--text-primary);">@toast.Title</div>
                    <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:2px;">@toast.Message</div>
                </div>
            </div>
            <button type="button" class="gi-btn-ghost" style="padding:0;border:none;background:transparent;cursor:pointer;color:var(--text-muted);font-size:0.9rem;" @onclick="() => ToastService.Remove(toast.Id)">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ToastService.OnChange -= StateHasChanged;
    }
}

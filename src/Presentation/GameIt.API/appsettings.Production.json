{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "GameItDbConnectionString": "Server=dbXXXXX.public.databaseasp.net;Database=dbXXXXX;User Id=dbXXXXX;Password=REPLACE_WITH_MONSTERASP_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-blazor-site.runasp.net"
    ]
  },
  "EmailSettings": {
    "ApiKey": "REPLACE_WITH_SENDGRID_API_KEY",
    "FromAddress": "noreply@your-blazor-site.runasp.net",
    "FromName": "GameIt"
  },
  "Stripe": {
    "SecretKey": "REPLACE_WITH_STRIPE_SECRET_KEY",
    "PublishableKey": "REPLACE_WITH_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "REPLACE_WITH_STRIPE_WEBHOOK_SECRET",
    "SuccessUrl": "https://your-blazor-site.runasp.net/library",
    "CancelUrl": "https://your-blazor-site.runasp.net/"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_MIN_32_CHAR_RANDOM_JWT_SIGNING_SECRET",
    "Issuer": "GameIt.Api",
    "Audience": "GameItUser",
    "DurationInMinutes": 60
  },
  "AllowedHosts": "*"
}

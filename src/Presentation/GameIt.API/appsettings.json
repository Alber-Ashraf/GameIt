{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "GameItDbConnectionString": "Server=(localdb)\\mssqllocaldb;Database=db_GameIt;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7294",
      "http://localhost:5036"
    ]
  },
  "EmailSettings": {
    "ApiKey": "REPLACE_VIA_USER_SECRETS_OR_ENV",
    "FromAddress": "noreply@gameit.local",
    "FromName": "GameIt"
  },
  "Stripe": {
    "SecretKey": "REPLACE_VIA_USER_SECRETS_OR_ENV",
    "PublishableKey": "REPLACE_VIA_USER_SECRETS_OR_ENV",
    "WebhookSecret": "REPLACE_VIA_USER_SECRETS_OR_ENV",
    "SuccessUrl": "https://localhost:7294/library",
    "CancelUrl": "https://localhost:7294/"
  },
  "JwtSettings": {
    "SecretKey": "dev-only-jwt-signing-key-replace-in-production-32chars!",
    "Issuer": "GameIt.Api",
    "Audience": "GameItUser",
    "DurationInMinutes": 60
  },
  "AllowedHosts": "*"
}
